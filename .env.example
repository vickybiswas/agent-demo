# Docker Compose Environment Variables
# Used by docker-compose.yaml when services run in containers
# Services communicate via container names (backend:8004, not localhost:8004)

# Frontend
NEXT_PUBLIC_API_URL=http://backend:8004
NODE_ENV=production

# Backend
API_URL=http://backend:8004
API_PORT=8004

# Copy this file to .env and update values before running docker-compose up
