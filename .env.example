# Environment Variables for Docker Production

# Frontend API URL (where frontend reaches backend)
# In Docker: use service name 'backend' (http://backend:8004)
# Local dev: use localhost (http://localhost:8004)
NEXT_PUBLIC_API_URL=http://backend:8004

# Backend CORS Allowed Origins (comma-separated)
# Allow frontend to call backend endpoints
# Includes both localhost (local testing) and service name (Docker network)
CORS_ORIGINS=http://localhost:3004,http://frontend:3004
