# Docker Environment Variables
# Copy this file to .env and adjust values as needed for Docker Compose deployment

# Frontend Configuration
FRONTEND_PORT=3004
# The port where the frontend service will run inside Docker
# Map to host with: ports: ["${FRONTEND_PORT}:3004"]

# Backend Configuration
BACKEND_PORT=8004
# The port where the backend service will run inside Docker
# Map to host with: ports: ["${BACKEND_PORT}:8004"]

# API URL for Frontend
NEXT_PUBLIC_API_URL=http://localhost:8004
# This is the URL the frontend (running in browser) uses to call the backend
# Use localhost:8004 because the frontend runs on the HOST machine (via Docker port mapping)
# NOT the container name (backend:8004) - that would fail from the browser

# Backend Configuration
PYTHONUNBUFFERED=1
# Ensures Python logs appear immediately in Docker logs (no buffering)
