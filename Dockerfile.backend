FROM python:3.11-slim

WORKDIR /app

# Copy requirements
COPY backend/requirements.txt .

# Install dependencies (fastapi, uvicorn only)
RUN pip install -r requirements.txt

# Copy source code
COPY backend/ .

# Expose port
EXPOSE 8004

# Start FastAPI server
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8004", "--reload"]
