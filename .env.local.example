# Local Development Environment Variables
# Copy this file to .env.local for local development (NOT Docker)
# .env.local takes precedence over .env

# Frontend Configuration
FRONTEND_PORT=3004
# Port for local npm run dev (frontend runs on localhost:3004)

# Backend Configuration
BACKEND_PORT=8004
# Port for local python3 main.py (backend runs on localhost:8004)

# API Configuration
API_URL=http://localhost:8004
# URL for backend API calls from local frontend

API_HOST=localhost
# Hostname for backend (use localhost, not 127.0.0.1)

API_PORT=8004
# Port for backend API calls

# Frontend API (used by Next.js browser)
NEXT_PUBLIC_API_URL=http://localhost:8004
# This MUST match the running backend URL
# Used by frontend code to call backend endpoints
# 'NEXT_PUBLIC_' prefix makes it available in browser

# Node Environment
NODE_ENV=development
# Set to 'development' for local dev, 'production' for builds

# Python Environment
PYTHONUNBUFFERED=1
# Ensures Python logs appear immediately (no buffering)

# Example Flow:
# 1. Start backend: python3 main.py (listens on localhost:8004)
# 2. Start frontend: npm run dev (runs on localhost:3004)
# 3. Open browser: http://localhost:3004
# 4. Frontend calls: http://localhost:8004/add?num1=5&num2=3
# 5. See result: 8
