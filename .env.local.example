# Local Development Environment Variables
# Used when running services locally (NOT in Docker)
# Services communicate via localhost (localhost:8004, not backend:8004)

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8004
NODE_ENV=development

# Backend
API_URL=http://localhost:8004
API_PORT=8004

# Copy this file to .env.local and keep it in .gitignore for local development
# DO NOT commit .env.local to git (contains local-only configuration)
