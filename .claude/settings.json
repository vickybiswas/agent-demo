{
  "hooks": [
    {
      "event": "file_created",
      "pattern": "**/*.py",
      "command": "auto-pep8 --in-place --aggressive --aggressive {file}",
      "description": "Auto-format Python files to PEP8 compliance on creation"
    },
    {
      "event": "file_created",
      "pattern": "**/*.ts",
      "command": "prettier --write {file}",
      "description": "Auto-format TypeScript files to ES6 compliance on creation"
    },
    {
      "event": "file_created",
      "pattern": "**/*.tsx",
      "command": "prettier --write {file}",
      "description": "Auto-format TSX files to ES6 compliance on creation"
    }
  ]
}
